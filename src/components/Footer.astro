---
import { SITE, SOCIALS } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <span>© {year} {SITE.name}</span>
    <span>
      {SOCIALS.map((s, i) => (
        <>
          {i > 0 && ' · '}
          <a href={s.href}>{s.label}</a>
        </>
      ))}
    </span>
  </div>
</footer>
