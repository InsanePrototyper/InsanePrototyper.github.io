---
import Base from '../layouts/Base.astro';
import { SITE, SOCIALS } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base>
  <section class="hero">
    <h1>{SITE.name}</h1>
    <p class="tagline">{SITE.tagline}</p>
    <p class="bio">
      I work on AI agents, RAG, and backend infrastructure at
      <a href="https://wolfia.com">Wolfia (YC)</a>. Before this I was at Flipkart
      and Safe Security. This site is where I keep my work, the projects I'm
      building, what I'm writing, and the books I'm reading.
    </p>
    <p class="meta">📍 {SITE.location}</p>
    <div class="socials">
      {SOCIALS.map((s) => <a href={s.href}>{s.label}</a>)}
    </div>
  </section>

  <h2 class="section-label">Latest writing</h2>
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a href={`/writing/${post.slug}`}>
          <span class="ptitle">{post.data.title}</span>
          <span class="pdate">{fmt(post.data.date)}</span>
          <span class="pdesc">{post.data.description}</span>
        </a>
      </li>
    ))}
  </ul>
  <p style="margin-top:16px"><a href="/writing">All posts →</a></p>
</Base>
