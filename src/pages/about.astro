---
import Base from '../layouts/Base.astro';
import { SOCIALS } from '../consts';
import {
  EXPERIENCE,
  EDUCATION,
  PUBLICATIONS,
  CERTIFICATIONS,
} from '../data/experience';

// Turn bare URLs inside a highlight into clickable links.
function linkify(text: string): string {
  const escaped = text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
  return escaped.replace(
    /(https?:\/\/[^\s)]+)/g,
    '<a href="$1" target="_blank" rel="noopener">$1</a>',
  );
}

// One muted line per role: dates, then location. "Full-time" is dropped
// (it reads like a resume); internships are kept since that is real context.
function meta(job: (typeof EXPERIENCE)[number]): string {
  const employment = job.employment === 'Full-time' ? undefined : job.employment;
  return [job.period, employment, job.location].filter(Boolean).join(' · ');
}
---

<Base title="About" description="A bit about me, what I've worked on, and how to reach me.">
  <h1>About</h1>
  <p class="lead">
    I'm a software engineer. Most of my work these days is on AI systems: agents,
    RAG, and the backend infrastructure that keeps them running.
  </p>

  <h2 class="section-label">Work</h2>
  <div class="roles">
    {EXPERIENCE.map((job) => (
      <article class="role">
        <h3 class="role-title">
          {job.role} <span class="role-at">at {job.company}</span>
        </h3>
        <p class="role-meta">{meta(job)}</p>
        {job.highlights.length > 0 && (
          <ul class="role-points">
            {job.highlights.map((h) => <li set:html={linkify(h)} />)}
          </ul>
        )}
        {job.stack && <p class="role-tech">{job.stack}</p>}
      </article>
    ))}
  </div>

  <h2 class="section-label">Education</h2>
  <div class="roles">
    {EDUCATION.map((ed) => (
      <article class="role">
        <h3 class="role-title">{ed.degree}</h3>
        <p class="role-meta">{ed.school} · {ed.period}</p>
        {ed.detail && <p class="role-tech">{ed.detail}</p>}
      </article>
    ))}
  </div>

  <h2 class="section-label">Publications</h2>
  <div class="roles">
    {PUBLICATIONS.map((pub) => (
      <article class="role">
        <h3 class="role-title">{pub.title}</h3>
        <p class="role-meta">{pub.venue} · {pub.date}</p>
      </article>
    ))}
  </div>

  <h2 class="section-label">Certifications</h2>
  <ul class="plain-list">
    {CERTIFICATIONS.map((c) => (
      <li>
        {c.title} <span class="role-meta">· {c.issuer}, {c.issued}</span>
      </li>
    ))}
  </ul>

  <h2 class="section-label">Off the clock</h2>
  <p>
    When I'm not building, I play a fair bit of Valorant. My stats live on my
    <a href="https://tracker.gg/valorant/profile/riot/AK18%239467/overview" target="_blank" rel="noopener"> tracker profile</a> (AK18#9467).
  </p>

  <h2 class="section-label">Elsewhere</h2>
  <div class="socials">
    {SOCIALS.map((s) => <a href={s.href}>{s.label}</a>)}
  </div>
</Base>
