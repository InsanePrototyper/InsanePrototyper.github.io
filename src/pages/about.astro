---
import Base from '../layouts/Base.astro';
import { SOCIALS } from '../consts';
import {
  EXPERIENCE,
  EDUCATION,
  PUBLICATIONS,
  CERTIFICATIONS,
} from '../data/experience';

// Turn bare URLs inside a highlight into clickable links.
function linkify(text: string): string {
  const escaped = text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
  return escaped.replace(
    /(https?:\/\/[^\s)]+)/g,
    '<a href="$1" target="_blank" rel="noopener">$1</a>',
  );
}
---

<Base title="About" description="Background, experience, education and how to reach me.">
  <h1>About</h1>
  <p class="lead">
    I'm a software engineer. Most of my work these days is on AI systems: agents,
    RAG, and the backend infrastructure that keeps them running.
  </p>

  <h2 class="section-label" style="margin-top:48px">Experience</h2>
  <div class="exp">
    {EXPERIENCE.map((job) => (
      <div class="exp-item">
        <div class="exp-head">
          <span class="exp-role">{job.role}</span>
          <span class="exp-co">{job.company}{job.employment ? ` · ${job.employment}` : ''}</span>
          <span class="exp-period">{job.period}</span>
        </div>
        {job.location && <p class="exp-loc">{job.location}</p>}
        {job.intro && <p class="exp-intro">{job.intro}</p>}
        {job.highlights.length > 0 && (
          <ul>
            {job.highlights.map((h) => <li set:html={linkify(h)} />)}
          </ul>
        )}
        {job.stack && <p class="exp-stack">{job.stack}</p>}
      </div>
    ))}
  </div>

  <h2 class="section-label" style="margin-top:48px">Education</h2>
  <div class="exp">
    {EDUCATION.map((ed) => (
      <div class="exp-item">
        <div class="exp-head">
          <span class="exp-role">{ed.degree}</span>
          <span class="exp-period">{ed.period}</span>
        </div>
        <p class="exp-loc">{ed.school}</p>
        {ed.detail && <p class="exp-stack">{ed.detail}</p>}
      </div>
    ))}
  </div>

  <h2 class="section-label" style="margin-top:48px">Publications</h2>
  <div class="exp">
    {PUBLICATIONS.map((pub) => (
      <div class="exp-item">
        <span class="exp-role">{pub.title}</span>
        <p class="exp-loc">{pub.venue} · {pub.date}</p>
      </div>
    ))}
  </div>

  <h2 class="section-label" style="margin-top:48px">Licenses &amp; certifications</h2>
  <div class="exp">
    {CERTIFICATIONS.map((c) => (
      <div class="exp-item">
        <div class="exp-head">
          <span class="exp-role">{c.title}</span>
          <span class="exp-period">{c.issued}</span>
        </div>
        <p class="exp-loc">{c.issuer}</p>
      </div>
    ))}
  </div>

  <h2 class="section-label" style="margin-top:48px">Off the clock</h2>
  <p>
    When I'm not building, I play a fair bit of Valorant. You can see my stats on
    my <a href="https://tracker.gg/valorant/profile/riot/AK18%239467/overview" target="_blank" rel="noopener">tracker profile</a> (AK18#9467).
  </p>

  <h2 class="section-label" style="margin-top:48px">Elsewhere</h2>
  <div class="socials">
    {SOCIALS.map((s) => <a href={s.href}>{s.label}</a>)}
  </div>
</Base>
